@model IEnumerable<ItemReport>
@{ ViewData["Title"] = "Admin Dashboard"; }
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4"><div><span class="eyebrow text-primary">CONTROL CENTRE</span><h1 class="h2 fw-bold mt-1">Admin dashboard</h1><p class="text-secondary">Manage reports and keep the campus listings reliable.</p></div><a asp-controller="Claims" asp-action="Index" class="btn btn-warning fw-semibold">Review claims</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><div><div class="stat-number">@ViewBag.Reports</div><div class="text-secondary">Total reports</div></div></div></div><div class="col-md-4"><div class="stat-card"><div><div class="stat-number">@ViewBag.PendingClaims</div><div class="text-secondary">Pending claims</div></div></div></div><div class="col-md-4"><div class="stat-card"><div><div class="stat-number">@ViewBag.Users</div><div class="text-secondary">Registered users</div></div></div></div></div>
<div class="table-responsive bg-white rounded-4 border"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Item</th><th>Type</th><th>Reported by</th><th>Status</th><th>Update status</th></tr></thead><tbody>
@foreach (var r in Model) { <tr><td><a asp-controller="Reports" asp-action="Details" asp-route-id="@r.Id">@r.Title</a><div class="text-secondary small">@r.Location</div></td><td>@r.ReportType</td><td>@r.User?.FullName</td><td><span class="status-pill">@r.Status</span></td><td><form asp-action="UpdateStatus" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id"/><select name="status" class="form-select form-select-sm">@foreach (ItemStatus s in Enum.GetValues<ItemStatus>()) { <option value="@s" selected="@(s == r.Status)">@s</option> }</select><button class="btn btn-sm btn-primary">Save</button></form></td></tr> }
@if (!Model.Any()) { <tr><td colspan="5" class="text-center text-secondary py-4">No reports have been posted.</td></tr> }
</tbody></table></div>
