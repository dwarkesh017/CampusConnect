@model ItemReport
@{ ViewData["Title"] = "Edit Report"; }
<div class="form-shell"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">← Back to report</a><h1 class="h2 fw-bold mt-3">Edit report</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-4">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id" /><partial name="_ReportForm" model="Model" /><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save changes</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
