@model ItemReport
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" placeholder="e.g. Black water bottle" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="ReportType" class="form-label"></label><select asp-for="ReportType" asp-items="Html.GetEnumSelectList<ReportType>()" class="form-select"></select><span asp-validation-for="ReportType" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option value="">Choose category</option>@foreach (var c in new[] {"ID card","Electronics","Keys","Wallet / Bag","Books / Stationery","Clothing","Water bottle","Other"}) { <option value="@c">@c</option> }</select><span asp-validation-for="Category" class="text-danger"></span></div></div>
<div class="mt-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the item. Avoid posting sensitive information publicly."></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="row g-3 mt-1"><div class="col-md-7"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" placeholder="e.g. Central library, ground floor" /><span asp-validation-for="Location" class="text-danger"></span></div><div class="col-md-5"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control" /><span asp-validation-for="EventDate" class="text-danger"></span></div></div>
